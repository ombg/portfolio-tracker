# Copy to .env and replace every change-me value. .env is git-ignored.
POSTGRES_PASSWORD=change-me
SERVICE_TOKEN=change-me
# Signs session cookies; at least 32 bytes. Generate with: openssl rand -base64 48
SESSION_SECRET=change-me
REPORTING_CURRENCY_DEFAULT=CAD
FILES_DIR=/data/files
TZ_MARKET=America/Toronto
