# Copy to .env and replace every change-me value. .env is git-ignored.
POSTGRES_PASSWORD=change-me
# Shared secret between portfolio-api and the internal services; at least 32 bytes: openssl rand -base64 48
SERVICE_TOKEN=change-me
# Password of the importer's own database role (D-35); at least 24 characters: openssl rand -hex 24
IMPORTER_DB_PASSWORD=change-me
# Password of market-data's own database role (D-39); at least 24 characters: openssl rand -hex 24
MARKET_DB_PASSWORD=change-me
# Market data provider: yahoo (default), off (no requests leave the machine; no prices) (D-39)
MARKET_DATA_PROVIDER=yahoo
# Signs session cookies; at least 32 bytes. Generate with: openssl rand -base64 48
SESSION_SECRET=change-me
REPORTING_CURRENCY_DEFAULT=CAD
FILES_DIR=/data/files
TZ_MARKET=America/Toronto
# Port of the web app on 127.0.0.1 (default 8080).
WEB_PORT=8080
# Secure flag on the session cookie (default false: the app is served over plain HTTP on 127.0.0.1, where Safari
# drops Secure cookies). Set true once the app is served over HTTPS (D-34).
COOKIE_SECURE=false
